# $MATTR_ARITH_DIR or this path; not vendored.
deps/arithmetic-wild/
# per-group uv environments (pyproject.toml [dependency-groups]: lm -> .venv, vit -> .venv-vit, tl2 -> .venv-tl2)
.venv*/
results/
logs/
logs_*/
plots/*
!plots/*.py
.claude/
paper/
*.log

# wandb run dirs (eval_sva.py --wandb); the run of record is on wandb.ai, not on disk
wandb/
